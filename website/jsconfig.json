{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "paths": {
      "/shared/*": [
        "./client/shared/*"
      ]
    },
    "experimentalDecorators": true,
    "types": []
  },
  "include": [
    "tachyon-env.d.ts",
    ".tachyon/types/client",
    "client/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client/shared/assets"
  ]
}
