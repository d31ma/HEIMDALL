# Local configuration and secrets
.env
.env.*
!.env.example
# Root-anchored: server/helpers/secrets and the docs' secrets pages are source
/secrets/
*.key
# Points at a local control plane; only the example ships
app/server/data/bff.json

# Runtime state: FYLO roots and SESAME deployments must never be committed
.heimdall/
fylo-root/
# Root-anchored: app/server/data holds the committed bff.example.json
/data/

# Build and test output
bin/
dist/
app/test-results/
/heimdall
*.test
*.prof
*.out
coverage/

# Tooling and OS metadata
graphify-out/
.DS_Store
Thumbs.db

# Vendored by scripts/vendor-duvay.sh, never committed — the CI web job
# enforces it. One source of truth lives in the DUVAY checkout.
app/client/shared/assets/duvay/
website/client/shared/assets/duvay/
node_modules/
